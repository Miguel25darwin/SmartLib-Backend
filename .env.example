# --- Base de données ---
DATABASE_URL=postgresql+psycopg2://smartlib_user:smartlib_pass@localhost:5432/smartlib_db

# --- Sécurité JWT ---
JWT_SECRET_KEY=change-moi-avec-une-valeur-aleatoire-longue
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES_CAMPUS=480
ACCESS_TOKEN_EXPIRE_MINUTES_REMOTE=120

# --- Application ---
APP_NAME=SmartLib API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
LOAN_DURATION_DAYS=14